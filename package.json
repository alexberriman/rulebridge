{
  "name": "rulebridge",
  "version": "0.1.0",
  "description": "Convert rules between json-rules-engine, JsonLogic, json-logic-engine, filtrex, jexl, expr-eval, expression-eval and Casbin matchers via a canonical intermediate representation. Zero runtime dependencies, Rust-style Result API.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "ci": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexberriman/rulebridge.git"
  },
  "keywords": [
    "rules",
    "rules-engine",
    "json-rules-engine",
    "json-logic",
    "json-logic-js",
    "json-logic-engine",
    "filtrex",
    "jexl",
    "expr-eval",
    "expression-eval",
    "casbin",
    "converter",
    "interop",
    "interoperability",
    "jsonlogic"
  ],
  "author": "Alex Berriman <alexb@bezz.com.au>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alexberriman/rulebridge/issues"
  },
  "homepage": "https://github.com/alexberriman/rulebridge",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.5",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/json-logic-js": "^2.0.8",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "casbin": "^5.51.1",
    "expression-eval": "^5.0.1",
    "fast-check": "^4.9.0",
    "filtrex": "^3.1.0",
    "husky": "^9.1.7",
    "jexl": "^2.3.0",
    "json-logic-engine": "^5.0.7",
    "json-logic-js": "^2.0.5",
    "json-rules-engine": "^7.3.1",
    "lint-staged": "^17.2.0",
    "publint": "^0.3.22",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
